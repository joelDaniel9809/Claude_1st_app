# Copy this file to ".env" and fill in real values. Never commit ".env".

# PostgreSQL connection used by the app, dbmate (migrations) and drizzle-kit.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/clinic_dev?sslmode=disable

# dbmate settings (paths are relative to the app/ folder)
DBMATE_MIGRATIONS_DIR=../sql/migrations
# Schema dumps need pg_dump on the PATH; off for now
DBMATE_NO_DUMP_SCHEMA=true
