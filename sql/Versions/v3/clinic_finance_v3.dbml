// =====================================================================
// Clinic Finance DB - v3 (PostgreSQL)
//
// Changes from v2:
//  1. invoices.invoice_number (unique per clinic + counterparty)
//  2. transactions.id_counterparty (optional: who paid / who was paid)
//  3. invoice_lines table. invoices.id_category replaced by
//     invoices.financial_type; each line carries its own category
//  4. Access control: permissions, role_permissions, user_clinic_access
//     (temporary cross-clinic grants) and an append-only audit_log
//  5. Single currency: no change
//  6/7. View changes (Void status, v_ledger) live in the constraints SQL
//
// Modelling assumptions:
//  * transactions = real cash movements only. Issuing an invoice does NOT
//    create a transaction. Reconciliation links the two.
//  * transactions.amount is always positive. Direction (in/out) comes from
//    the category's financial_type.
//  * Financial data is never hard-deleted: restrict + soft delete/void/cancel.
//  * Rules DBML can't express (triggers, exclusion constraints, partial
//    unique indexes, views) live in clinic_finance_v3_constraints.sql
// =====================================================================

Enum "enum_financial_type" {
  "Income"
  "Expense"
}

Enum "enum_periodicity" {
  "Daily"
  "Weekly"
  "Biweekly"
  "Monthly"
  "Quarterly"
  "Annual"
  "Variable"
}

Enum "enum_transaction_status" {
  "Completed"
  "Pending"
  "Cancelled"
}

// 'Fully Depreciated' is derived from dates (see v_clinic_assets)
Enum "enum_asset_status" {
  "Active"
  "Sold"
  "Damaged Write-Off"
}

// What a transaction means in relation to an asset
Enum "enum_asset_link_type" {
  "Purchase"
  "Maintenance"
  "Revenue"
  "Other"
}

// ---------------------------------------------------------------------
// Lookup tables
// ---------------------------------------------------------------------

Table "clinics" {
  "id_clinic" serial [pk, increment]
  "clinic_name" varchar(150) [not null]
  "address" text
  "active" boolean [not null, default: true, note: "Soft delete. Never cascade-delete a clinic's financial history"]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "financial_categories" {
  "id_category" serial [pk, increment]
  "financial_type" enum_financial_type [not null]
  "category_name" varchar(100) [not null]
  "suggested_periodicity" enum_periodicity [not null, default: 'Variable', note: "Hint for the UI only"]

  indexes {
    (financial_type, category_name) [unique]
    (id_category, financial_type) [unique, note: "Target for the composite FK that makes invoice lines match their invoice's type"]
  }
}

Table "payment_methods" {
  "id_method" serial [pk, increment]
  "method_name" varchar(50) [unique, not null]
}

Table "depreciation_categories" {
  "id_dep_category" serial [pk, increment]
  "category_name" varchar(100) [unique, not null]
  "useful_life_months" int [not null, note: "Single source of truth. Straight-line annual % = 1200 / useful_life_months"]

  Checks {
    `useful_life_months > 0` [name: 'chk_dep_life_positive']
  }
}

Table "counterparties" {
  "id_counterparty" serial [pk, increment]
  "counterparty_name" varchar(150) [not null]
  "tax_id" varchar(50) [unique, note: "Optional, unique when present"]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: "Suppliers, patients, insurers... Patient data is personal: access is limited by clinic and logged in audit_log"
}

// ---------------------------------------------------------------------
// People and access control
// ---------------------------------------------------------------------

Table "roles" {
  "id_role" serial [pk, increment]
  "role_name" varchar(50) [unique, not null]
  "description" text
}

Table "permissions" {
  "id_permission" serial [pk, increment]
  "permission_code" varchar(100) [unique, not null, note: "e.g. invoices.view, invoices.create, invoices.void, transactions.create, reconciliation.reverse, reports.view, users.manage, clinics.view_all, audit.view"]
  "description" text
}

Table "role_permissions" {
  "id_role" int [not null]
  "id_permission" int [not null]

  indexes {
    (id_role, id_permission) [pk]
  }

  Note: "What each role may do. Being a system admin (users.manage) does NOT imply reading financial/patient data: that needs its own permissions"
}

Table "users" {
  "id_user" serial [pk, increment]
  "first_name" varchar(100) [not null]
  "last_name" varchar(100) [not null]
  "email" varchar(150) [unique, not null]
  "phone" varchar(20)
  "id_clinic" int [note: "Home clinic: the user sees this clinic's data. NULL = HQ user with no clinic data by default. Other clinics only via the clinics.view_all permission or an active user_clinic_access grant"]
  "id_role" int [not null]
  "password_hash" varchar(255) [not null]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "user_clinic_access" {
  "id_access" serial [pk, increment]
  "id_user" int [not null, note: "Who receives access"]
  "id_clinic" int [not null, note: "Clinic they may access"]
  "id_granted_by" int [not null, note: "Who approved it"]
  "reason" text [not null, note: "Why, e.g. ticket number for maintenance"]
  "granted_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz [not null, note: "Every grant is temporary"]
  "revoked_at" timestamptz [note: "Set to end the grant early. Never delete rows"]

  indexes {
    (id_user, id_clinic)
    id_clinic
  }

  Checks {
    `expires_at > granted_at` [name: 'chk_access_expiry']
    `revoked_at IS NULL OR revoked_at >= granted_at` [name: 'chk_access_revoked']
    `id_user <> id_granted_by` [name: 'chk_access_not_self_granted']
  }

  Note: "Temporary 'break-glass' access to another clinic (maintenance, audits, cover). Active = revoked_at IS NULL AND now() < expires_at"
}

Table "audit_log" {
  "id_audit" bigserial [pk, increment]
  "id_user" int [note: "NULL = system/automated action"]
  "id_clinic" int [note: "Clinic whose data was touched, if any"]
  "action" varchar(50) [not null, note: "e.g. view, create, update, void, reverse, export, login, access_granted, access_revoked"]
  "table_name" varchar(100)
  "record_id" bigint
  "details" jsonb [note: "Before/after values or other context"]
  "ip_address" varchar(45)
  "created_at" timestamptz [not null, default: `now()`]

  indexes {
    (id_clinic, created_at)
    (id_user, created_at)
    (table_name, record_id)
  }

  Note: "Append-only: rows can't be updated or deleted (enforced in the SQL file)"
}

// ---------------------------------------------------------------------
// Assets and service lines
// ---------------------------------------------------------------------

Table "service_lines" {
  "id_service_line" serial [pk, increment]
  "id_clinic" int [not null]
  "service_name" varchar(150) [not null, note: "e.g. Office Visit, Counseling. A revenue/cost center, not a physical asset"]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id_clinic, service_name) [unique]
    (id_service_line, id_clinic) [unique, note: "Target for the composite FK that keeps clinics consistent"]
  }
}

Table "clinic_assets" {
  "id_asset" serial [pk, increment]
  "id_clinic" int [not null]
  "asset_name" varchar(150) [not null]
  "serial_number" varchar(100) [unique, note: "Optional for every asset"]
  "is_depreciable" boolean [not null, default: true]
  "id_dep_category" int [note: "Required if and only if is_depreciable"]
  "acquisition_cost" numeric(12,2) [not null, default: 0.00]
  "purchase_date" date [not null, default: `CURRENT_DATE`]
  "depreciation_start_date" date [note: "Required if and only if is_depreciable"]
  "asset_status" enum_asset_status [not null, default: 'Active']
  "disposal_date" date
  "disposal_amount" numeric(12,2) [note: "Sale price, only meaningful when Sold"]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    id_clinic
    (id_asset, id_clinic) [unique, note: "Target for the composite FK that keeps clinics consistent"]
  }

  Checks {
    `(is_depreciable AND id_dep_category IS NOT NULL AND depreciation_start_date IS NOT NULL) OR (NOT is_depreciable AND id_dep_category IS NULL AND depreciation_start_date IS NULL)` [name: 'chk_depreciation_conditional']
    `acquisition_cost >= 0` [name: 'chk_asset_cost_nonneg']
    `depreciation_start_date IS NULL OR depreciation_start_date >= purchase_date` [name: 'chk_dep_start_after_purchase']
    `(asset_status = 'Active' AND disposal_date IS NULL AND disposal_amount IS NULL) OR (asset_status = 'Sold' AND disposal_date IS NOT NULL AND disposal_date >= purchase_date) OR (asset_status = 'Damaged Write-Off' AND disposal_date IS NOT NULL AND disposal_date >= purchase_date AND disposal_amount IS NULL)` [name: 'chk_asset_disposal']
  }
}

Table "operator_allocations" {
  "id_allocation" serial [pk, increment]
  "id_user" int [not null]
  "id_asset" int
  "id_service_line" int
  "allocation_percentage" numeric(5,2) [not null, default: 100.00, note: "Share of the user's working time/salary dedicated to this target"]
  "assigned_at" date [not null, default: `CURRENT_DATE`]
  "retracted_at" date [note: "NULL while the user is still assigned"]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    id_user
    id_asset
    id_service_line
  }

  Checks {
    `(id_asset IS NOT NULL AND id_service_line IS NULL) OR (id_asset IS NULL AND id_service_line IS NOT NULL)` [name: 'chk_alloc_exactly_one_target']
    `allocation_percentage > 0 AND allocation_percentage <= 100` [name: 'chk_alloc_pct_range']
    `retracted_at IS NULL OR retracted_at >= assigned_at` [name: 'chk_alloc_dates']
  }

  Note: "No-overlap and total <= 100% per user are enforced in the SQL file"
}

// ---------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------

Table "transactions" {
  "id_transaction" bigserial [pk, increment]
  "id_clinic" int [not null]
  "id_category" int [not null]
  "id_method" int [not null]
  "id_registered_by" int [not null, note: "User who recorded the entry"]
  "id_payee_user" int [note: "User who received the money, e.g. payroll"]
  "id_counterparty" int [note: "NEW. Who paid / who was paid (patient, supplier, insurer). Optional. If set, it must match the invoice's counterparty when reconciled"]
  "id_asset" int
  "asset_link_type" enum_asset_link_type [note: "What this transaction is to the asset. Required iff id_asset is set"]
  "id_service_line" int
  "amount" numeric(12,2) [not null, note: "Always positive. Direction comes from the category"]
  "transaction_date" date [not null, default: `CURRENT_DATE`, note: "When the money actually moved. Entry time = created_at"]
  "description" text
  "transaction_status" enum_transaction_status [not null, default: 'Completed', note: "Reports must only count Completed: use the v_ledger view"]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id_clinic, transaction_date)
    id_category
    id_counterparty
    id_asset
    id_service_line
    id_payee_user
  }

  Checks {
    `amount > 0` [name: 'chk_trx_amount_positive']
    `(id_asset IS NULL) = (asset_link_type IS NULL)` [name: 'chk_trx_asset_link']
  }
}

Table "invoices" {
  "id_invoice" serial [pk, increment]
  "id_clinic" int [not null]
  "id_counterparty" int [not null]
  "invoice_number" varchar(50) [not null, note: "NEW. Receivables: generated by the app per clinic. Payables: the supplier's own number"]
  "financial_type" enum_financial_type [not null, note: "NEW, replaces id_category. Income = receivable, Expense = payable. Categories now live on each line"]
  "total_amount" numeric(12,2) [not null, note: "Must equal the sum of its invoice_lines.line_total (checked at commit in the SQL file)"]
  "issue_date" date [not null]
  "due_date" date [not null]
  "is_void" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id_clinic, id_counterparty, invoice_number) [unique, note: "Supplier numbers can repeat across suppliers, so uniqueness includes the counterparty"]
    (id_invoice, financial_type) [unique, note: "Target for the composite FK from invoice_lines"]
    (id_clinic, due_date)
    id_counterparty
  }

  Checks {
    `total_amount > 0` [name: 'chk_invoice_total_positive']
    `due_date >= issue_date` [name: 'chk_invoice_dates']
  }

  Note: "Paid amount and status are derived from reconciliation_history (see v_invoice_balances)"
}

Table "invoice_lines" {
  "id_line" serial [pk, increment]
  "id_invoice" int [not null]
  "line_number" smallint [not null, note: "Order on the invoice: 1, 2, 3..."]
  "description" varchar(255) [not null, note: "e.g. Consultation, Lab test"]
  "financial_type" enum_financial_type [not null, note: "Copy of the invoice's type. The two composite FKs force the line's category to have the same type as its invoice"]
  "id_category" int [not null]
  "id_service_line" int [note: "Optional. Must belong to the invoice's clinic (checked in the SQL file)"]
  "quantity" numeric(10,2) [not null, default: 1]
  "unit_price" numeric(12,2) [not null]
  "line_total" numeric(12,2) [not null, note: "= ROUND(quantity * unit_price, 2), enforced by a check"]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  indexes {
    (id_invoice, line_number) [unique]
    id_category
    id_service_line
  }

  Checks {
    `quantity > 0` [name: 'chk_line_qty_positive']
    `unit_price >= 0` [name: 'chk_line_price_nonneg']
    `line_total = ROUND(quantity * unit_price, 2)` [name: 'chk_line_total']
  }
}

Table "reconciliation_history" {
  "id_reconciliation" serial [pk, increment]
  "id_invoice" int [not null]
  "id_transaction" bigint [not null]
  "id_user" int [not null]
  "applied_amount" numeric(12,2) [not null]
  "reconciliation_date" timestamptz [not null, default: `now()`]
  "reversed_at" timestamptz [note: "Append-only audit trail: undo = set this, never delete"]

  indexes {
    id_invoice
    id_transaction
  }

  Checks {
    `applied_amount > 0` [name: 'chk_recon_amount_positive']
  }

  Note: "One ACTIVE link per (invoice, transaction) pair: partial unique index in the SQL file"
}

// ---------------------------------------------------------------------
// Relationships (everything restrict: financial data is never cascaded away)
// ---------------------------------------------------------------------

// Access control
Ref: "clinics"."id_clinic" < "users"."id_clinic" [delete: restrict]
Ref: "roles"."id_role" < "users"."id_role" [delete: restrict]
Ref: "roles"."id_role" < "role_permissions"."id_role" [delete: restrict]
Ref: "permissions"."id_permission" < "role_permissions"."id_permission" [delete: restrict]
Ref: "users"."id_user" < "user_clinic_access"."id_user" [delete: restrict]
Ref: "users"."id_user" < "user_clinic_access"."id_granted_by" [delete: restrict]
Ref: "clinics"."id_clinic" < "user_clinic_access"."id_clinic" [delete: restrict]
Ref: "users"."id_user" < "audit_log"."id_user" [delete: restrict]
Ref: "clinics"."id_clinic" < "audit_log"."id_clinic" [delete: restrict]

// Assets and service lines
Ref: "clinics"."id_clinic" < "service_lines"."id_clinic" [delete: restrict]
Ref: "clinics"."id_clinic" < "clinic_assets"."id_clinic" [delete: restrict]
Ref: "depreciation_categories"."id_dep_category" < "clinic_assets"."id_dep_category" [delete: restrict]
Ref: "users"."id_user" < "operator_allocations"."id_user" [delete: restrict]
Ref: "clinic_assets"."id_asset" < "operator_allocations"."id_asset" [delete: restrict]
Ref: "service_lines"."id_service_line" < "operator_allocations"."id_service_line" [delete: restrict]

// Transactions
Ref: "clinics"."id_clinic" < "transactions"."id_clinic" [delete: restrict]
Ref: "financial_categories"."id_category" < "transactions"."id_category" [delete: restrict]
Ref: "payment_methods"."id_method" < "transactions"."id_method" [delete: restrict]
Ref: "users"."id_user" < "transactions"."id_registered_by" [delete: restrict]
Ref: "users"."id_user" < "transactions"."id_payee_user" [delete: restrict]
Ref: "counterparties"."id_counterparty" < "transactions"."id_counterparty" [delete: restrict]
// Composite FKs: the asset / service line must belong to the SAME clinic as the transaction
Ref: "transactions".("id_asset", "id_clinic") > "clinic_assets".("id_asset", "id_clinic") [delete: restrict]
Ref: "transactions".("id_service_line", "id_clinic") > "service_lines".("id_service_line", "id_clinic") [delete: restrict]

// Invoices
Ref: "clinics"."id_clinic" < "invoices"."id_clinic" [delete: restrict]
Ref: "counterparties"."id_counterparty" < "invoices"."id_counterparty" [delete: restrict]
// Composite FKs: a line has the same type as its invoice, and its category has that type too
Ref: "invoice_lines".("id_invoice", "financial_type") > "invoices".("id_invoice", "financial_type") [delete: restrict]
Ref: "invoice_lines".("id_category", "financial_type") > "financial_categories".("id_category", "financial_type") [delete: restrict]
Ref: "service_lines"."id_service_line" < "invoice_lines"."id_service_line" [delete: restrict]

// Reconciliation
Ref: "invoices"."id_invoice" < "reconciliation_history"."id_invoice" [delete: restrict]
Ref: "transactions"."id_transaction" < "reconciliation_history"."id_transaction" [delete: restrict]
Ref: "users"."id_user" < "reconciliation_history"."id_user" [delete: restrict]
